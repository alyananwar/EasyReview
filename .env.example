# EasyReview environment template. Copy to .env.local and fill in.
# Never commit .env.local — it's already in .gitignore.

# --- Dashboard auth ---
# Password to access the dashboard. Set a strong random value.
DASHBOARD_PASSWORD=
# Secret for signing session cookies. Generate: openssl rand -hex 32
COOKIE_SECRET=

# --- QuickBooks Online ---
# Create an app at https://developer.intuit.com/app/developer/myapps
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://yourdomain.com/api/auth/quickbooks/callback
QUICKBOOKS_ENV=sandbox   # flip to "production" for a live shop

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never expose to the browser

# --- Twilio SMS ---
# Create an account at twilio.com and buy a local phone number (~$1/mo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12095550100   # the Twilio number you purchased

# --- Business branding ---
BUSINESS_NAME=Your Shop Name
REVIEW_LINK=https://maps.app.goo.gl/your-review-link

# --- Batch behavior ---
DAILY_CAP=40              # hard cap per run; extras get marked over_cap
DAYS_BACK=3               # only text customers invoiced in the last N days
MIN_DELAY_MS=1000         # minimum jitter between sends (ms)
MAX_DELAY_MS=3000         # maximum jitter between sends (ms)
# On Vercel free tier (60s function limit), set both to 0 for near-instant batches

# --- Cron protection ---
# Used as a bearer token for the /api/cron endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Alerting ---
# Slack incoming webhook URL (or any POST endpoint that accepts { text: string }).
# If set, EasyReview posts here when a run fails or completes with 0 sent + failures.
ALERT_WEBHOOK_URL=

# --- Re-text window ---
# Days before a customer is eligible to receive another review request.
# Default 90. Set to 0 to disable re-texting entirely (permanent one-shot).
RETEXT_DAYS=90

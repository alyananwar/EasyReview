# EasyReview environment template. Copy to .env.local and fill in.
# On the shop PC this lives at C:\EasyReview\.env.local. Never commit it.
# After editing, restart the app:  deploy   (or reboot the PC)

# --- Public address (Tailscale Funnel) ---
# The shop PC's https://<machine>.<tailnet>.ts.net address. No trailing slash.
# Used for Twilio signature checks; must also prefix QUICKBOOKS_REDIRECT_URI.
PUBLIC_URL=https://lockeford-pc.tail1234.ts.net
# Dashboard only reachable from your tailnet; Funnel only serves /privacy,
# /terms and the Twilio webhook. Leave "true" on the shop PC.
TAILNET_ONLY=true

# --- Dashboard auth ---
# Password to access the dashboard. Set a strong random value.
DASHBOARD_PASSWORD=
# Secret for signing session cookies. Generate: openssl rand -hex 32
COOKIE_SECRET=

# --- QuickBooks Online ---
# Create an app at https://developer.intuit.com/app/developer/myapps
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://lockeford-pc.tail1234.ts.net/api/auth/quickbooks/callback
QUICKBOOKS_ENV=sandbox   # flip to "production" once Intuit approves the app

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12095550100   # the Twilio number you purchased

# --- Alerts ---
# Your cell. Gets a text when a run fails or QuickBooks disconnects
# (once per outage, not every run). Leave empty to turn alerts off.
ALERT_PHONE=

# --- Business branding ---
BUSINESS_NAME=Lockeford Garage
REVIEW_LINK=https://maps.app.goo.gl/your-review-link

# --- Schedule ---
# Shop-local hours (24h) for the automatic run. Default: every 2 hours, 9am-5pm.
# Quiet hours and the pause switch on the dashboard still apply.
RUN_HOURS=9,11,13,15,17

# --- Batch behavior ---
DAILY_CAP=40              # max texts per rolling 24 hours, across all runs; extras are marked over_cap
DAYS_BACK=7               # look at invoices from the last N days (dashboard text says 7)
MIN_DELAY_MS=1000         # random pause between sends (ms)
MAX_DELAY_MS=3000
RETEXT_DAYS=90            # days before a customer can get another request (0 = never)

# --- Manual trigger over SSH ---
# Bearer token for /api/cron and /api/health. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Optional ---
# DB_PATH=data\easyreview.db   # default; backups go to data\backups (14 days kept)
